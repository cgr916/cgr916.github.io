---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<Base
  title={post.data.title}
  description={post.data.summary || post.data.title}
  ogType="article"
>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.tags.length > 0 && <span>{post.data.tags.join(' / ')}</span>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      {
        post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((t) => (
              <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
            ))}
          </div>
        )
      }
      <a class="back-link" href="/">← 回到文章列表</a>
    </footer>
  </article>
</Base>
