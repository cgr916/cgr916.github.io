---
import Base from '../layouts/Base.astro';
import { getPosts, getTags, fmtDate } from '../lib/posts';

const tags = await getTags();
const all = await getPosts();
const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title="归档"
  active="archive"
  description={`全部 ${posts.length} 篇文章，按主题与时间两种索引。`}
>
  <section class="intro">
    <h1>归档</h1>
    <p>一共 {posts.length} 篇。按时间倒序排，找那篇就行。</p>
  </section>

  {
    tags.length > 0 && (
      <div class="archive-block">
        <h2 class="section-label">按主题</h2>
        <nav class="tag-index">
          {tags.map(({ tag, count }) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
              <span class="tag-count">{count}</span>
            </a>
          ))}
        </nav>
      </div>
    )
  }

  <div class="archive-block">
    <h2 class="section-label">按时间</h2>
    <ul class="timeline">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
