---
import { SITE } from '../config';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {Astro.props.title ? `${Astro.props.title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`}
    </title>
    <meta name="description" content={Astro.props.description ?? SITE.description} />
    <meta name="author" content={SITE.author} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={Astro.props.ogType ?? 'website'} />
    <meta property="og:title" content={Astro.props.title ?? SITE.title} />
    <meta property="og:description" content={Astro.props.description ?? SITE.description} />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary" />
    <style is:inline>
      html {
        color-scheme: light dark;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE.title}</a>
        <nav class="site-nav">
          <a href="/" aria-current={Astro.props.active === 'home' ? 'page' : undefined}>文章</a>
          <a href="/archive" aria-current={Astro.props.active === 'archive' ? 'page' : undefined}>归档</a>
          <a href="/about" aria-current={Astro.props.active === 'about' ? 'page' : undefined}>关于</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <span> · </span>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
